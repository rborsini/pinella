# Pinella – sottocartella /pinella/ dentro il sito di Gruzzolo

# Pagina predefinita della cartella: senza questa riga Netsons risponde 403 su /pinella/
DirectoryIndex index.html

# Niente elenco dei file
Options -Indexes

# Blocca file nascosti, di configurazione e sorgenti non destinati al web
<FilesMatch "^\.|\.(sql|md|py|ini|log|bak)$">
    Require all denied
</FilesMatch>

# Attivare il motore qui fa sì che le eventuali regole di riscrittura di Gruzzolo
# (cartella superiore) non vengano applicate dentro /pinella/
RewriteEngine On

<IfModule mod_headers.c>
    # Pinella non può essere incorporata in altre pagine
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    # App e service worker sempre aggiornati dopo un nuovo caricamento via FTP
    <FilesMatch "\.(html|js|css|webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
